# --- environment / editor
.venv/
.DS_Store
analysis script_checkpoints/
__pycache__/
*.pyc
.streamlit/secrets.toml

# --- raw inputs that stay off GitHub (large, or contain private detail)
# 78 + 41 MB LiDAR scans -> archive on Zenodo / Drive (see README)
data/raw/pointcloud/*.ply
# site photographs (one shows the farm WiFi credentials)
data/raw/picture/
# design drawing (PDF/PPTX, 12 MB) from the contractor
data/raw/doc/
# 13 MB long-format telemetry store (rebuilt by scripts/update_store.py)
data/raw/iot/*.parquet

# --- derived caches (rebuilt by the processing pipeline)
data/processed/*.npz
data/processed/*.parquet
# 1 MB 10-min table: KEPT so the web app has data on deploy
!data/processed/iot_10min.parquet
figures/html/

# --- manuscript drafts stay private until submission
paper/
PFAL_Imaging_Robot/

# --- research pipeline stays local: the public repo is the web app + data (paper cites it as code/model/data store)
figures/
scripts/photos_to_jpg.sh
docs/*
!docs/DATA_DICTIONARY.md
.streamlit/tuya_token.json
data/raw/meter/
data/backup/
